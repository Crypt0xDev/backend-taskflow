APP_NAME=TaskFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend domain (CORS allowlist). For several, separate with commas.
FRONTEND_URL=http://localhost:3000

# Base users created by AdminUserSeeder (php artisan db:seed).
# Set the passwords in your local .env (never commit real secrets).
# If a *_PASSWORD is left empty, the seeder generates a random one and prints it.
ADMIN_EMAIL=admin@taskflow.test
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DEMO_EMAIL=demo@taskflow.test
DEMO_USERNAME=demo
DEMO_PASSWORD=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=taskflow
DB_USERNAME=postgres
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@taskflow.test"
MAIL_FROM_NAME="${APP_NAME}"
