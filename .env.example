# Variables de entorno para la aplicación TaskFlow

# Datos de la aplicación
APP_NAME=TaskFlow
APP_ENV=local
APP_KEY=<base64:your_app_key_here>
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL del frontend
FRONTEND_URL=http://localhost:3000

# Credenciales
ADMIN_EMAIL=admin@taskflow.test
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DEMO_EMAIL=demo@taskflow.test
DEMO_USERNAME=demo
DEMO_PASSWORD=

# Log
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Configuración de la base de datos
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=taskflow
DB_USERNAME=postgres
DB_PASSWORD=

# Cache, session y queue
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# MailS
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@taskflow.test"
MAIL_FROM_NAME="${APP_NAME}"
